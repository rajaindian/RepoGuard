{
  "name": "repoguard",
  "version": "1.0.0",
  "description": "Security scanner for GitHub repositories — protects no-coders from malicious code",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "repoguard": "./dist/bin/repoguard.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist",
    "rules"
  ],
  "keywords": ["security", "scanner", "github", "malware", "code-review"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "pdfkit": "^0.18.0",
    "repomix": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
